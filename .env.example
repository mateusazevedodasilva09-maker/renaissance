# Copier ce fichier vers `.env` et remplir les valeurs.

# Chaîne de connexion PostgreSQL
# Local :   postgresql://postgres:motdepasse@localhost:5432/renaissance
# Neon :    postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/renaissance?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renaissance"

# Secret utilisé pour signer les sessions (JWT).
# Générer une valeur aléatoire longue, ex. : openssl rand -base64 48
AUTH_SECRET="changez-moi-par-une-longue-chaine-aleatoire"

# Identifiants du compte admin créés par le seed (prisma/seed.js)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="renaissance2026"
SEED_ADMIN_EMAIL="mateusazevedodasilva09@gmail.com"
